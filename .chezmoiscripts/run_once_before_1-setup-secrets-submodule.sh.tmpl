#!/usr/bin/env bash

{{ if ne .secretsRepo "" }}
# Do not try to get `secrets` submodule if on remote machine
if [ -z "$SSH_CONNECTION" ] && [ -z "$SSH_CLIENT" ] && [ -z "$SSH_TTY" ]; then
    cat <<'EOF' >$HOME/.local/share/chezmoi/.gitmodules
[submodule "secrets"]
    path = secrets
    url = {{ .secretsRepo }}
    ignore = all
EOF
fi
{{ end }}
