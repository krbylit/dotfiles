{
  "mcpServers": {
    "time": {
      "args": ["mcp-server-time"],
      "command": "uvx"
    },
    "websearch": {
      "command": "npx",
      "args": ["websearch-mcp"],
      "environment": {
        "API_URL": "http://localhost:3001",
        "MAX_SEARCH_RESULT": "5"
      }
    },
    "fetch": {
      "args": [
        "/Users/kirbylittle/.local/share/mcp-servers/fetch-mcp/dist/index.js"
      ],
      "command": "node"
    },
    "sequential-thinking": {
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "command": "npx"
    },
    "memory": {
      "args": [
        "run",
        "-i",
        "-v",
        "claude-memory:/app/dist",
        "--rm",
        "mcp/memory"
      ],
      "command": "docker"
    },
    "git": {
      "args": ["mcp-server-git"],
      "command": "uvx"
    },
    "filesystem": {
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "~/"],
      "command": "npx"
    },
    "github": {
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "command": "docker"
    },
    "software-planning-tool": {
      "args": [
        "/Users/kirbylittle/.local/share/mcp-servers/Software-planning-mcp/build/index.js"
      ],
      "disabled": false,
      "command": "node",
      "autoApprove": []
    }
  }
}
