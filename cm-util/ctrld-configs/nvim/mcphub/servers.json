{
  "mcpServers": {
    "time": {
      "args": ["mcp-server-time"],
      "command": "uvx"
    },
    "awslabs.terraform-mcp-server": {
      "autoApprove": [],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "command": "uvx",
      "args": ["awslabs.terraform-mcp-server@latest"],
      "disabled": false
    },
    "awslabs.aws-diagram-mcp-server": {
      "autoApprove": [],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "command": "uvx",
      "args": ["awslabs.aws-diagram-mcp-server"],
      "disabled": false
    },
    "fetch": {
      "args": ["{ABSOLUTE PATH TO FILE HERE}/dist/index.js"],
      "command": "node"
    },
    "sequential-thinking": {
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "command": "npx"
    },
    "neo4j-aura": {
      "args": ["mcp-neo4j-cypher@0.2.3", "--transport", "stdio"],
      "env": {
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "<your-password>",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_DATABASE": "neo4j"
      },
      "command": "uvx"
    },
    "awslabs.code-doc-gen-mcp-server": {
      "autoApprove": [],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "command": "uvx",
      "args": ["awslabs.code-doc-gen-mcp-server@latest"],
      "disabled": false
    },
    "memory": {
      "args": [
        "run",
        "-i",
        "-v",
        "claude-memory:/app/dist",
        "--rm",
        "mcp/memory"
      ],
      "command": "docker"
    },
    "git": {
      "args": ["mcp-server-git"],
      "command": "uvx"
    },
    "awslabs.aws-documentation-mcp-server": {
      "autoApprove": [],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "disabled": false
    },
    "playwright": {
      "args": ["-y", "@executeautomation/playwright-mcp-server"],
      "command": "npx"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/username/Desktop",
        "/path/to/other/allowed/dir"
      ],
      "command": "npx"
    },
    "notionApi": {
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ntn_****\", \"Notion-Version\": \"2022-06-28\" }"
      },
      "command": "npx"
    },
    "github": {
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_TOKEN>"
      },
      "command": "docker"
    },
    "awslabs.frontend-mcp-server": {
      "autoApprove": [],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "command": "uvx",
      "args": ["awslabs.frontend-mcp-server@latest"],
      "disabled": false
    },
    "software-planning-tool": {
      "args": ["/path/to/software-planning-tool/build/index.js"],
      "disabled": false,
      "command": "node",
      "autoApprove": []
    }
  },
  "nativeMCPServers": {
    "neovim": {
      "disabled": false
    }
  }
}
