# PATH setup
# set -gx PATH $PATH /usr/local/bin # Homebrew on Intel silicon
set -gx PATH \
    $HOME/.cargo/bin \
    $HOME/.local/bin \
    $HOME/.local/share/bob/nvim-bin \
    $HOME/go/bin \
    $HOME/.cache/.bun/bin \
    $HOME/.local/share/pnpm \
    /opt \
    /opt/homebrew/sbin \
    /opt/homebrew/bin \
    /nix/var/nix/profiles/default/bin \
    /Applications/Obsidian.app/Contents/MacOS \
    $PATH
